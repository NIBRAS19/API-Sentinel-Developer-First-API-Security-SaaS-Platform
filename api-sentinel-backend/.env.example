DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SQLite configuration (Set USE_SQLITE=1 for SQLite, or USE_SQLITE=0 for PostgreSQL)
USE_SQLITE=1

# Celery local execution: Set to 1 to run scan tasks synchronously without Redis
CELERY_TASK_ALWAYS_EAGER=1

# PostgreSQL Configuration (used when USE_SQLITE=0)
POSTGRES_DB=api_sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Broker URL (used when USE_SQLITE=0 and CELERY_TASK_ALWAYS_EAGER=0)
REDIS_URL=redis://redis:6379/0

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
SECURE_SSL_REDIRECT=0
